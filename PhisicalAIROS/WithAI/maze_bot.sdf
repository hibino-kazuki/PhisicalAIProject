        <model name="maze_bot">
            <pose>0 0 0.2 0 0 0</pose>
            <link name="base_link">
                <inertial>
                    <!-- hollow steel box 1.0x0.8x0.2 m, 5 mm plate, density 7850 kg/m^3 -->
                    <mass>89.50</mass>
                    <inertia><ixx>6.996</ixx><iyy>10.07</iyy><izz>15.71</izz></inertia>
                </inertial>
                <visual name="visual">
                    <geometry><box><size>1.0 0.8 0.2</size></box></geometry>
                    <material>
                        <ambient>0 0 1 1</ambient> <diffuse>0 0 1 1</diffuse>
                    </material>
                </visual>
                <collision name="collision">
                    <geometry><box><size>1.0 0.8 0.2</size></box></geometry>
                </collision>

                <sensor name="gpu_lidar" type="gpu_lidar">
                    <pose>0.2 0 0.4 0 0 0</pose>
                    <topic>lidar</topic>
                    <update_rate>10</update_rate>
                    <lidar>
                        <scan>
                            <horizontal>
                                <samples>1080</samples>
                                <resolution>1</resolution>
                                <min_angle>-3.14159</min_angle> <max_angle>3.14159</max_angle>  </horizontal>
                        </scan>
                        <range>
                            <min>0.15</min>
                            <max>10.0</max>
                        </range>
                    </lidar>
                    <visualize>true</visualize>
                    <always_on>1</always_on>
                </sensor>

                <!-- front-facing RGB camera: publishes camera (image) and camera_info -->
                <sensor name="front_camera" type="camera">
                    <pose>0.5 0 0.15 0 0 0</pose>
                    <topic>camera</topic>
                    <update_rate>10</update_rate>
                    <camera>
                        <horizontal_fov>1.047</horizontal_fov>
                        <image>
                            <width>640</width>
                            <height>480</height>
                            <format>R8G8B8</format>
                        </image>
                        <clip>
                            <near>0.1</near>
                            <far>10.0</far>
                        </clip>
                    </camera>
                    <visualize>true</visualize>
                    <always_on>1</always_on>
                </sensor>
            </link>

            <link name="left_wheel">
                <pose>0 0.44 0 -1.57 0 0</pose>
                <inertial>
                    <!-- solid rubber cylinder r=0.2 m, l=0.08 m, density 1150 kg/m^3 -->
                    <mass>11.56</mass>
                    <inertia><ixx>0.1218</ixx><iyy>0.1218</iyy><izz>0.2312</izz></inertia>
                </inertial>
                <visual name="v"><geometry><cylinder><radius>0.2</radius><length>0.08</length></cylinder></geometry></visual>
                <collision name="c">
                    <geometry><cylinder><radius>0.2</radius><length>0.08</length></cylinder></geometry>
                    <!-- rubber tire on floor -->
                    <surface><friction><ode><mu>1.0</mu><mu2>1.0</mu2></ode></friction></surface>
                </collision>
            </link>
            <link name="right_wheel">
                <pose>0 -0.44 0 -1.57 0 0</pose>
                <inertial>
                    <!-- solid rubber cylinder r=0.2 m, l=0.08 m, density 1150 kg/m^3 -->
                    <mass>11.56</mass>
                    <inertia><ixx>0.1218</ixx><iyy>0.1218</iyy><izz>0.2312</izz></inertia>
                </inertial>
                <visual name="v"><geometry><cylinder><radius>0.2</radius><length>0.08</length></cylinder></geometry></visual>
                <collision name="c">
                    <geometry><cylinder><radius>0.2</radius><length>0.08</length></cylinder></geometry>
                    <!-- rubber tire on floor -->
                    <surface><friction><ode><mu>1.0</mu><mu2>1.0</mu2></ode></friction></surface>
                </collision>
            </link>
            <link name="caster">
                <pose>-0.4 0 -0.1 0 0 0</pose>
                <inertial>
                    <!-- solid rubber sphere r=0.1 m, density 1150 kg/m^3 -->
                    <mass>4.817</mass>
                    <inertia><ixx>0.01927</ixx><iyy>0.01927</iyy><izz>0.01927</izz></inertia>
                </inertial>
                <visual name="v"><geometry><sphere><radius>0.1</radius></sphere></geometry></visual>
                <collision name="c">
                    <geometry><sphere><radius>0.1</radius></sphere></geometry>
                    <!-- rubber ball caster on floor -->
                    <surface><friction><ode><mu>1.0</mu><mu2>1.0</mu2></ode></friction></surface>
                </collision>
            </link>
            <!-- thin plate on the rear of the body top, hinged at its rear edge (x=-0.45).
                 lies flat at 0 rad, stands vertical at 1.5708 rad.
                 standing height 0.25 m keeps its top (z=0.355) below the LiDAR scan plane (z=0.4). -->
            <link name="plate">
                <pose>-0.325 0 0.105 0 0 0</pose>
                <inertial>
                    <!-- aluminium plate 0.25x0.6x0.01 m, density 2700 kg/m^3 -->
                    <mass>4.05</mass>
                    <inertia><ixx>0.1215</ixx><iyy>0.02113</iyy><izz>0.1426</izz></inertia>
                </inertial>
                <visual name="v">
                    <geometry><box><size>0.25 0.6 0.01</size></box></geometry>
                    <material><ambient>1 0.8 0 1</ambient><diffuse>1 0.8 0 1</diffuse></material>
                </visual>
                <collision name="c"><geometry><box><size>0.25 0.6 0.01</size></box></geometry></collision>
            </link>

            <joint name="left_joint" type="revolute">
                <parent>base_link</parent><child>left_wheel</child><axis><xyz>0 0 1</xyz></axis>
            </joint>
            <joint name="right_joint" type="revolute">
                <parent>base_link</parent><child>right_wheel</child><axis><xyz>0 0 1</xyz></axis>
            </joint>
            <joint name="caster_joint" type="ball"><parent>base_link</parent><child>caster</child></joint>
            <joint name="plate_joint" type="revolute">
                <!-- hinge at the plate's rear bottom edge; positive angle lifts the front edge -->
                <pose>-0.125 0 -0.005 0 0 0</pose>
                <parent>base_link</parent><child>plate</child>
                <axis>
                    <xyz>0 -1 0</xyz>
                    <limit><lower>0</lower><upper>1.5708</upper></limit>
                    <dynamics><damping>1.0</damping></dynamics>
                </axis>
            </joint>

            <plugin filename="gz-sim-diff-drive-system" name="gz::sim::systems::DiffDrive">
                <topic>cmd_vel</topic>
                <left_joint>left_joint</left_joint>
                <right_joint>right_joint</right_joint>
                <wheel_separation>0.88</wheel_separation>
                <wheel_radius>0.2</wheel_radius>
            </plugin>

            <!-- plate angle command: gz.msgs.Double [rad] on topic plate_cmd -->
            <plugin filename="gz-sim-joint-position-controller-system" name="gz::sim::systems::JointPositionController">
                <joint_name>plate_joint</joint_name>
                <topic>plate_cmd</topic>
                <p_gain>100</p_gain>
                <i_gain>0</i_gain>
                <d_gain>10</d_gain>
                <cmd_max>50</cmd_max>
                <cmd_min>-50</cmd_min>
            </plugin>
        </model>
    </world>
</sdf>